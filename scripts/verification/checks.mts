import type {
  RiskLayer,
  Surface,
  VerificationCheck,
  VerificationProfile,
} from "./types.mts";

const QUICK_PROFILES: VerificationProfile[] = [
  "changed",
  "quick",
  "release",
  "package",
];
const RELEASE_PROFILES: VerificationProfile[] = ["release", "package"];

function pnpmCheck(
  id: string,
  label: string,
  surfaces: Surface[],
  layers: RiskLayer[],
  args: string[],
  options: Partial<
    Pick<
      VerificationCheck,
      "profiles" | "dependsOn" | "timeoutMs" | "resourceGroup"
    >
  > & { environment?: Record<string, string> } = {},
): VerificationCheck {
  return {
    id,
    label,
    surfaces,
    layers,
    profiles: options.profiles ?? QUICK_PROFILES,
    command: { executable: "pnpm", args, environment: options.environment },
    dependsOn: options.dependsOn,
    timeoutMs: options.timeoutMs ?? 120_000,
    resourceGroup: options.resourceGroup,
  };
}

