{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/check-large-data-budgets.ts",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts",
    "../../packages/**/*"
  ],
  "exclude": ["node_modules", "out"]
}
